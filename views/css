.nav-main {
    display: none;

    @media @min1100 {
        display: inline-block;
    }

    .chevron,
    .arrow {
        display: none !important;
    }

    // ==========================================
    // MAIN NAVIGATION
    // ==========================================
    >ul {
        .menu-alignment();

        >li {
            display: inline-block;
            position: relative;
            cursor: pointer;
            --submenu-left: 260px; // where the 3rd-level panel (and hover bridge) starts

            &:has(.has-children) {
                >a {
                    pointer-events: none;
                }
            }


            // ==========================================
            // FIRST DROPDOWN
            // ==========================================
            >ul {
                position: absolute;
                top: 100%;
                left: -33%;
                // transform: translateX(-50%);
                width: 310px;
                .dark();
                border-radius: 2%;
                padding: 0;
                margin-top: 15px;
                max-height: 0;
                opacity: 0;
                visibility: hidden;
                overflow: hidden;
                display: flex;
                gap: var(--space-24);
                flex-direction: column;
                transition:
                    width 0.35s ease,
                    max-height 0.4s ease,
                    opacity 0.3s ease,
                    visibility 0.3s ease,
                    padding 0.3s ease;

                // ==========================================
                // FIRST LEVEL ITEMS
                // ==========================================
                >li {
                    display: inline-block;
                    // width: 100%;
                    position: relative;

                    >a {
                        display: inline-block;
                        // width: 100%;
                        padding: 0px 40px;
                        color: var(--white);
                        font-family: var(--font-primary);
                        font-weight: 700;
                        font-size: 18px;
                        line-height: 30px;
                        transition: color 0.2s ease;

                        &:hover {
                            color: var(--pri-400);
                        }
                    }

                    // ======================================
                    // SUB-SUB MENU
                    // ======================================
                    >ul {
                        display: none;
                    }

                    // ======================================
                    // WHEN ITEM HAS CHILDREN
                    // ======================================
                    &.has-children {
                        >a {
                            position: relative;
                        }
                    }
                }
            }

            // ==========================================
            // MAIN NAV LINK
            // ==========================================
            >a {
                color: var(--white);
                font-family: var(--font-primary);
                font-weight: 700;
                font-size: 20px;
                line-height: 28px;
                transition: color 0.2s ease;

                &:hover {
                    color: var(--pri-400);
                }
            }

            // ==========================================
            // OPEN FIRST DROPDOWN
            // ==========================================
            &:hover {
                >a {
                    color: var(--pri-400);
                }

                >ul {
                    max-height: 1000px;
                    opacity: 1;
                    visibility: visible;
                    padding: 24px 0px;
                    box-sizing: border-box;
                    overflow: visible;
                }
            }

            // ==========================================
            // EXPAND DROPDOWN WHEN CHILDREN ARE HOVERED
            // ==========================================
            &:has(> ul > li.has-children:hover) {
                >ul {
                    width: 800px;
                }
            }

            // ==========================================
            // EXPANDED SUBMENU CONTENT
            // ==========================================


            >ul {

                >li.has-children {
                    position: static;

                    // Hide all third-level menus by default
                    >ul {
                        display: none;
                    }

                    // Only show the submenu of the hovered item
                    &:hover {

                        >ul {
                            display: grid;
                            // width: calc(100% - 375px);
                            grid-template-columns: 1fr;
                            position: absolute;
                            top: 24px;
                            left: var(--submenu-left);
                            right: 0;
                            padding: 0px 30px;
                            margin: 0;
                            border-left: 1px solid rgba(255, 255, 255, 0.25);
                            gap: 24px 30px;
                            align-content: start;
                            z-index: 10;
                            min-height: 100px;

                            >li {
                                display: block;
                                width: 100%;

                                >a {
                                    display: block;
                                    padding: 0;
                                    color: var(--white);
                                    font-family: var(--font-primary);
                                    font-weight: 400;
                                    font-size: 16px;
                                    line-height: 28px;
                                    transition: color 0.2s ease;

                                    &:hover {
                                        color: var(--pri-400);
                                    }
                                }
                            }
                        }

                        >a {
                            color: var(--pri-400);
                        }

                        // ==================================
                        // HOVER BRIDGE
                        // Invisible full-height layer over the sub-menu area.
                        // The panel is pinned to the top, so without this the
                        // pointer crosses the (full-width) rows of the items
                        // above and switches to their sub-menus.
                        // ==================================
                        &::after {
                            content: "";
                            position: absolute;
                            top: 0;
                            bottom: 0;
                            left: var(--submenu-left);
                            right: 0;
                            cursor: default;
                        }
                    }
                }

                >li.has-children.submenu-2-columns:hover {
                    >ul {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }
                }

                >li.has-children.submenu-3-columns:hover {
                    >ul {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }
                }

            }

            // Locations submenu only
            &.menu-item-96>ul>li.has-children:nth-child(4) {

                >ul {
                    max-height: 246px;
                    overflow-y: auto;
                    overflow-x: hidden;
                    gap: 16px 8px;

                    >li>a {
                        font-size: 15px;
                    }
                }
            }

            // Wider left column for menu-item-97
            &.menu-item-97 {
                --submenu-left: 310px;
            }
        }
    }
}