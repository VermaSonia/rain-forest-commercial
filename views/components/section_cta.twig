{% if post.post_type in ['industry', 'case-studies', 'location', 'commercial-hvac', 'commercial-plumbing', 'commercial-refrigera', 'commercial-water-hea', 'project-improvement', 'property-maintenance'] %}
	{% set flex = post.meta('comp') %}
{% else %}
	{% set flex = field.meta('comp') %}
{% endif %}

{% for page in flex %}
	{% if page.acf_fc_layout == 'cta_section' %}
		<section class="section-cta" data-aos="fade-zoom-in" data-aos-easing="ease-in-back" id="section-cta">
				<div class="img-content">
					<img src="{{get_image(page.image).src}}" alt="{{get_image(page.image).src}}" class="img-responsive">
				</div>
				<div class="text-content padding-lr">
					<div class="text-container">
						<h2 class="white center">{{page.title }}</h2>
						<div class="content center white">{{page.content}}</div>
						<a class="primary-btn modal-trigger" href="{{site.url}}">Request a Proposal</a>
					</div>
				</div>
		</section>
	{% endif %}
{% endfor %}