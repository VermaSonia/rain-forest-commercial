{% if post.post_type in ['industry', 'case_studies', 'location', 'commercial-hvac', 'commercial-plumbing', 'commercial-refrigera', 'commercial-water-hea', 'project-improvement', 'property-maintenance'] %}
	{% set flex = post.meta('comp') %}
{% else %}
	{% set flex = field.meta('comp') %}
{% endif %}

{% for page in flex %}
	{% if page.acf_fc_layout == 'section_cards' %}
		<section class="section-10-cards padding" id="section-10-cards">
			<div class="container">
				<div class="text-container">
					<div class="text-content">
						<h2 class="charcol center title">{{page.title}}</h2>
						<div class="content center">{{page.content }}</div>
					</div>
				</div>
				<div class="serving-list section-medium-top">
					{% for list in page.industries %}
						<div class="list-item">
							<div class="img-content">
								<img src="{{get_image(list.image).src}}" alt="{{get_image(list.image).src}}" class="img-responsive">
							</div>
							<div class="text-content">
								<h3 class="charcol h6 title">{{list.title }}</h3>
								<div class="content small">{{list.content }}</div>
								<a href="{{list.link}}" aria-label="Visit industry Page" class="visit-btn">Visit Industry page{{ source(directory ~ '/static/images/icon/arrow-link.svg') }}</a>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endfor %}