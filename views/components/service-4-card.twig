{% for page in field.meta('comp') %}
	{% if page.acf_fc_layout == 'section_4_cards' %}
		<section class="section-four-cards padding" id="section-four-cards">
			<div class="container">
				<div class="text-container">
					<div class="text-content">
						<h2 class="charcol title">{{page.title}}</h2>
						<div class="content">{{page.content }}</div>
					</div>
					<div class="btn">
						<a href="/industries-served" aria-label="Industries Served" class="phone-btn">
							View All
							{{ source(directory ~ '/static/images/icon/arrow-link.svg') }}
						</a>
					</div>
				</div>
				<div class="serving-list section-medium-top">
					{% for list in page.industries %}
						<a class="list-item" href="{{list.link}}" aria-label="{{list.title}}">
							<div class="img-content">
								<img src="{{get_image(list.image).src}}" alt="{{get_image(list.image).src}}" class="img-responsive">
							</div>
							<div class="text-content">
								<h3 class="charcol h6 title">{{list.title }}</h3>
								<div class="content small">{{list.content }}</div>
							</div>
						</a>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endfor %}