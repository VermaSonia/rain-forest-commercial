{% if post.post_type in ['industry', 'case_studies', 'location', 'commercial-hvac', 'commercial-plumbing', 'commercial-refrigera', 'commercial-water-hea', 'project-improvement', 'property-maintenance'] %}
	{% set flex = post.meta('comp') %}
{% else %}
	{% set flex = field.meta('comp') %}
{% endif %}

{% for page in flex %}
	{% if page.acf_fc_layout == 'section_6_cards' %}
		<section class="section-6-cards padding" id="section-6-cards">
			<div class="container">
				<div class="head-container">
					<h2 class="charcol center title">{{ page.title }}</h2>
					<div class="content center">{{ page.content }}</div>
				</div>
				<div class="commitment section-medium-top" id="commitment">
					{% for list in page.cards %}
						<div class="list-item">
							<div class="logo">
								<img src="{{get_image(list.logo).src}}" alt="{{get_image(list.logo).alt}}" class="img-responsive">
							</div>
							<h3 class="charcol title">{{list.title }}</h3>
							<div class="content charcol">{{list.content }}</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endfor %}