{% if post.post_type in ['industry', 'case-studies', 'location', 'commercial-hvac', 'commercial-plumbing', 'commercial-refrigera', 'commercial-water-hea', 'project-improvement', 'property-maintenance'] %}
	{% set flex = post.meta('comp') %}
{% else %}
	{% set flex = field.meta('comp') %}
{% endif %}

{% for page in flex %}
    {% if page.acf_fc_layout == 'section_trust' %}
        <section class="section-trust padding" id="section-trust">
            <div class="container">
                <div class="left-content">
                    <h2 class="charcol title">{{ page.title }}</h2>
                </div>
                <div class="right-content">
                    <div class="content">{{ page.content }}</div>
                    <div class="line"></div>
                    <div class="numbers">
                        {% for list in page.numbers %}
                            <div class="list-item">
                                <div class="statistics-number-wrap-2" data-number="{{ list.number }}"></div>
                                <p class="title">{{ list.title }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>
    {% endif %}
{% endfor %}

