{% if post.post_type in ['industry', 'case-studies', 'location', 'commercial-hvac', 'commercial-plumbing', 'commercial-refrigera', 'commercial-water-hea', 'project-improvement', 'property-maintenance'] %}
	{% set flex = post.meta('comp') %}
{% else %}
	{% set flex = field.meta('comp') %}
{% endif %}

{% for page in flex %}
	{% if page.acf_fc_layout == 'what_to_expact' %}
		<section class="what-to-expect padding" data-aos="fade-zoom-in" data-aos-easing="ease-in-back" id="what-to-expect">
			<div class="container">
				<div class="img-content">
					<img src="{{ get_image(page.image).src }}" alt="{{ get_image(page.image).src }}" class="img-responsive">
				</div>
				<div class="expect-section">
					<h2 class="charcol title">{{ page.title }}</h2>
					<div class="expect-list section-medium-top">
						{% for list in page.expect_list %}
							{% set count = (count|default(0)) + 1 %}
							<div class="list-item faq-button">
								<p class="count">0{{ count }}.</p>
								<div class="text-content">
									<h3 class="faq-question h5 charcol">{{ list.title|lower|capitalize}}</h3>
									<div class="faq-answer">
										{{ list.content|wpautop }}
									</div>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>
			</div>
		</section>
	{% endif %}
{% endfor %}
