{% if post.post_type in ['industry', 'case-studies', 'location', 'commercial-hvac', 'commercial-plumbing', 'commercial-refrigera', 'commercial-water-hea', 'project-improvement', 'property-maintenance'] %}
	{% set flex = post.meta('comp') %}
{% else %}
	{% set flex = field.meta('comp') %}
{% endif %}

{% for page in flex %}
	{% if page.acf_fc_layout == 'faq' %}
		<section class="faq-section padding" data-aos="fade-zoom-in" data-aos-easing="ease-in-back" id="faq-section">
			<div class="container">
				<div class="head-container">
					<h2 class="charcol center title">{{ page.title }}</h2>
					<div class="content center">{{ page.content }}</div>
				</div>
				<div class="faq-list section-medium-top">
					{% for list in page.faq %}
						<div class="list-item faq-button">
							<div class="text-content">
								<h3 class="faq-question h5 charcol">
									{{ list.question|lower|capitalize }}
									{{ source(directory ~ '/static/images/icon/plus.svg') }}
								</h3>
								<div class="faq-answer">
									{{ list.answer|wpautop }}
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endfor %}
