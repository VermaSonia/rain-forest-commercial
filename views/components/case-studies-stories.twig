{% if post.post_type in ['industry', 'case_studies', 'location', 'commercial-hvac', 'commercial-plumbing', 'commercial-refrigera', 'commercial-water-hea', 'project-improvement', 'property-maintenance'] %}
	{% set flex = post.meta('comp') %}
{% else %}
	{% set flex = field.meta('comp') %}
{% endif %}

{% for page in flex %}
	{% if page.acf_fc_layout == 'section_trust' %}
		<section class="section-trust padding" id="section-trust">
			<div class="container"></div>
		</section>
	{% endif %}
{% endfor %}