{% if post.post_type in ['industry', 'case-studies', 'location', 'commercial-hvac', 'commercial-plumbing', 'commercial-refrigera', 'commercial-water-hea', 'project-improvement', 'property-maintenance'] %}
	{% set flex = post.meta('comp') %}
{% else %}
	{% set flex = field.meta('comp') %}
{% endif %}

{% for page in flex %}
	{% if page.acf_fc_layout == 'locations_section' %}
		<section class="locations-section padding" data-aos="fade-zoom-in" data-aos-easing="ease-in-back" id="locations-section">
			<div class="container">
				<div class="head-container">
					<h2 class="charcol center title">{{ page.title }}</h2>
					<div class="content center">{{ page.content }}</div>
				</div>
				<div class="locations-list section-medium-top">
					{% for list in locations %}
						<div class="list-item">
							<a href="{{ list.link }}" aria-label="{{ list.title }}" class="location-btn">{{ source(directory ~ '/static/images/icon/pin.svg') }} <span>{{ list.title }} {{ source(directory ~ '/static/images/icon/arrow-link.svg') }}</span></a>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endfor %}
