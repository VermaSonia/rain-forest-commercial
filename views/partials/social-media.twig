<div class="social-media">
   {% if options.social_media.linkedin %}
    <a href="{{ options.social_media.linkedin }}" target="_blank" rel="noopener noreferrer"  aria-label="open linkedin">
      {{ source(directory ~ '/static/images/social/linkedin.svg') }}
    </a>
  {% endif %}
   {% if options.social_media.yelp %}
    <a href="{{ options.social_media.yelp }}" target="_blank" rel="noopener noreferrer"  aria-label="open yelp">
      {{ source(directory ~ '/static/images/social/yelp.svg') }}
    </a>
  {% endif %}
  {% if options.social_media.instagram %}
    <a href="{{ options.social_media.instagram }}" target="_blank" rel="noopener noreferrer"  aria-label="open instagram">
      {{ source(directory ~ '/static/images/social/instagram.svg') }}
    </a>
  {% endif %}
    {% if options.social_media.facebook %}
      <a href="{{ options.social_media.facebook }}" target="_blank" rel="noopener noreferrer"  aria-label="open facebook">
        {{ source(directory ~ '/static/images/social/facebook.svg') }}
      </a>
    {% endif %}  
</div>